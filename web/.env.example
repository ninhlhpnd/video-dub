# Chép file này thành .env rồi sửa. Biến môi trường thật (systemd, Docker…) được ưu tiên hơn .env.

# Khoá ký cookie đăng nhập. Để trống: tự tạo và lưu trong data/secret_key.txt
SECRET_KEY=
# Thư mục dữ liệu (site.db, ảnh bìa, ảnh đại diện). Mặc định: web/data
DATA_DIR=
SITE_NAME=Truyện Hay
SITE_TAGLINE=Đọc truyện chữ online miễn phí, cập nhật liên tục
# Địa chỉ công khai, dùng cho link tuyệt đối (API, sitemap, canonical). Ví dụ https://truyenhay.vn
SITE_URL=
# 1 khi chạy sau HTTPS (Cloudflare/nginx) để cookie chỉ gửi qua HTTPS
COOKIE_SECURE=0

# Dịch truyện Trung: gemini | claude (| mock = dịch giả lập để thử giao diện)
TRANSLATOR=gemini
GEMINI_API_KEY=
# danh sách model Gemini dự phòng, cách nhau dấu phẩy
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 1 = chạy luồng dịch nền trong tiến trình web; 0 = tự chạy `python -m app.worker` riêng
WORKER=1
# số giây nghỉ giữa hai lần tải trang nguồn
FETCH_DELAY=1.5

# Ủng hộ trang (/ung-ho) – có thể sửa trong Quản trị → Cài đặt
# Mã BIN ngân hàng, ví dụ 970436 = Vietcombank, 970422 = MB, 970407 = Techcombank
SITE_DONATE_BANK=
SITE_DONATE_ACCOUNT=
SITE_DONATE_NAME=
SITE_DONATE_MOMO=
SITE_DONATE_LINK=
# Khoá bí mật cho webhook SePay/Casso (để trống = tắt webhook)
DONATE_WEBHOOK_SECRET=
